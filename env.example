# Runtime API
RUNTIME_PORT=8000
ENV=local
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["*"]

# Database
DATABASE_URL=postgresql://agentops:agentops@localhost:5432/agentops

# Redis
REDIS_URL=redis://localhost:6379

# LLM Provider (to be configured)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=

# Adapters
ORCHESTRATOR_ADAPTER=inmemory
LLM_ADAPTER=echo
VECTOR_STORE_ADAPTER=inmemory
TELEMETRY_ADAPTER=inmemory
